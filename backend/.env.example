# 복사해서 사용: cp .env.example .env  (.env 는 git 에 올리지 않음)
# 값이 비어 있으면 코드의 기본값을 쓴다. 아래 키 이름은 backend/app/core/settings.py 와 같다.

# ===== 서버 =====
# dev | prod  (dev 이면 손님·관리자 화면이 로그인 상태로 바로 시작한다 — 운영 배포에는 절대 dev 로 두지 말 것. prod 에서는 JWT_SECRET, ADMIN_TOKEN 이 기본값(change-me)이면 서버가 뜨지 않음)
APP_ENV=dev
# DB 주소. 기본은 로컬 SQLite 파일, Supabase(Postgres)를 쓰려면 아래 주석처럼 지정 (테이블은 서버가 처음 뜰 때 자동 생성)
# Supabase: Project Settings → Database → Connection string → "Session pooler" 주소 (IPv4 호환, Render 등에서 사용)
# DATABASE_URL=postgresql://postgres.<프로젝트ref>:<DB비밀번호>@aws-0-<리전>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./app.db
# 서버 API 를 호출할 수 있는 화면 주소 목록 (JSON 배열)
CORS_ORIGINS=["http://localhost:8501","http://localhost:8502"]
# 관리자 API 인증 토큰. 운영에서는 반드시 긴 임의 문자열로 교체
ADMIN_TOKEN=change-me

# ===== QR 로그인 / 카카오 =====
# 휴대폰이 접속할 서버 주소 (QR 에 들어감). 휴대폰 시험 시 서버 PC 의 IP 로 변경 (예: http://192.168.0.10:8000)
PUBLIC_BASE_URL=http://localhost:8000
# 카카오 키를 비워 두면 모의 카카오 로그인 화면이 열린다
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/auth/kakao/callback
# 로그인 때 자동으로 받아올 카카오 동의항목(공백으로 구분). 카카오 콘솔에 설정하지 않은 항목이 있으면 KOE205 오류
# 휴대폰 번호(phone_number)는 비즈 앱 심사가 필요하므로, 아직이면 이 항목을 빼 두세요
KAKAO_SCOPES=name gender birthday birthyear phone_number
# 카카오 로그인을 Supabase Auth 로 처리할 때 (URL 과 ANON 키가 모두 있으면 직접 호출 대신 이 방식 사용)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 서버 전용 비밀 키(절대 화면/깃에 노출 금지). 현재 로그인·DB 흐름에는 쓰지 않음
SUPABASE_SERVICE_ROLE_KEY=
# 로그인 JWT 서명 비밀값. 운영에서는 32자 이상 임의 문자열로 교체
JWT_SECRET=change-me
# QR 로그인 유효 시간(초)
LOGIN_TTL_SECONDS=180
# 로그인 후 JWT 유효 시간(분)
JWT_EXPIRE_MINUTES=720

# ===== 문자 발송 (솔라피) =====
# true 면 솔라피를 호출하지 않고 발송 기록만 남긴다 (실제 발송 시 false)
SMS_DRY_RUN=true
# 개발 흐름 확인용 DB 테스트 API (기본값 false)
DEV_TEST_BUTTON=false
# 발송 테스트: POST /admin/api/sms/test (ADMIN_TOKEN 필요, README 참고)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 솔라피에 등록·인증된 발신번호
SOLAPI_SENDER_NUMBER=
# 광고 문자 하단에 넣는 무료수신거부 번호 (실제 발송에 필수)
SMS_OPT_OUT_NUMBER=
# 월 무료 발송 한도 (SMS / LMS 건수)
SMS_MONTHLY_LIMIT=50
LMS_MONTHLY_LIMIT=10

# ===== AI 문자 후보 · 외부 정보 =====
# 제미나이 무료 API 키. 비워 두면 AI 대신 템플릿 문구로 후보를 만든다
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 서울 열린데이터광장(data.seoul.go.kr) 인증키: 오늘 행사 문구용. 비워 두면 행사 문구는 비운다
SEOUL_OPENAPI_KEY=

# ===== 매장 정보 =====
STORE_NAME=역전할머니맥주
STORE_BRANCH=홍대점
STORE_SLOGAN=옛날 그 맛 그대로, 시원한 생맥주 한 잔!
STORE_TABLES=30

# ===== 고객 등급 기준 (임시값) =====
# 방문 N회 이상이면 재방문 / 단골, 마지막 방문 후 N일 이상이면 휴면
GRADE_REPEAT_VISITS=2
GRADE_REGULAR_VISITS=5
GRADE_DORMANT_DAYS=30

# ===== 화면(Streamlit user·admin) — 서버가 아니라 화면 실행 환경에서 읽는 값 =====
# 아래는 .env 가 아니라 셸 환경변수 또는 Streamlit 배포 설정(Secrets/Env)에 넣는다.
# API_URL=http://127.0.0.1:8000     # 화면이 호출할 서버 주소
# DATA_SOURCE=auto                  # dummy | api | auto (auto: 서버가 닿으면 api, 아니면 dummy)
# ADMIN_SKIP_TOKEN=1                # 0/false 로 두면 관리자 화면에서 토큰 입력을 요구 (토큰은 ADMIN_TOKEN)
